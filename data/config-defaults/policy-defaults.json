{
  "$schemaVersion": "0.1.0",
  "templateName": "Humanitarian NGO — Default Template",
  "description": "Default policy parameters for HRMO. Values are examples derived from a reference national-staff policy manual and must be verified by each customer against its own policies and local labor law. Keys map to rule IDs in docs/en/system-reference.md.",
  "validFrom": "2026-01-01",
  "validTo": null,

  "organization": {
    "multiCountry": true,
    "grantAllocationEnabled": true,
    "languages": ["en", "ar"],
    "defaultLanguage": "en",
    "branding": {
      "organizationName": "<Organization name>",
      "organizationNameAr": "<اسم المؤسسة>",
      "logoUrl": "",
      "primaryColor": "#0F6CBD",
      "reportingChannelUrl": "<Independent reporting channel URL>",
      "reportingChannelPhone": "",
      "hrContactEmail": "<hr@example.org>"
    }
  },

  "countryPolicy": {
    "code": "SAMPLE",
    "name": "Sample Country Policy Set",
    "currencies": ["USD", "ILS"],
    "workWeek": {
      "days": ["SUN", "MON", "TUE", "WED", "THU"],
      "hoursPerDay": 8,
      "startTime": "08:00",
      "endTime": "16:00",
      "breaks": [
        { "type": "LUNCH", "minutes": 30 },
        { "type": "REST", "minutes": 15 }
      ],
      "maxWeeklyHours": 40
    },
    "holidays": {
      "approval": "HEAD_OF_OFFICE",
      "allowCarryOver": false,
      "calendar": []
    },
    "severance": {
      "monthsPerYear": 1,
      "basis": "LAST_BASIC",
      "completedYearsOnly": true,
      "settleAtProjectEnd": true
    },
    "laborAuthorityNotification": {
      "disciplinaryDismissal": true,
      "redundancy": true,
      "courtConviction": true
    }
  },

  "employmentCategories": {
    "regular": {
      "key": "REGULAR",
      "isEmployee": true,
      "minContractMonths": 3,
      "timeRecording": "MONTHLY_TIMESHEET_AND_DAILY_ATTENDANCE",
