  },

  "overtime": {
    "requiresPreApproval": true,
    "notifyHrBeforeWork": true,
    "rateMultiplier": 1.5,
    "maxHoursPerDay": 2,
    "compensationModes": ["PAY", "COMP_LEAVE"]
  },

