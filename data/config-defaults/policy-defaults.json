        "annualLeave": true, "sickLeave": true, "otherLeave": true, "overtime": true,
        "thirteenthMonth": true, "healthInsurance": true, "severance": true, "relocationAllowance": true
      }
    },
    "fixedShort": {
      "key": "FIXED_SHORT",
      "isEmployee": true,
      "timeRecording": "MONTHLY_TIMESHEET",
      "eligibility": {
        "annualLeave": false, "sickLeave": true, "otherLeave": true, "overtime": true,
        "thirteenthMonth": false, "healthInsurance": false, "severance": false, "relocationAllowance": false
      }
    },
    "daily": {
      "key": "DAILY",
      "isEmployee": true,
      "timeRecording": "DAILY_ATTENDANCE",
      "eligibility": {
        "annualLeave": false, "sickLeave": false, "otherLeave": false, "overtime": false,
        "thirteenthMonth": false, "healthInsurance": false, "severance": false, "relocationAllowance": false
      }
    },
    "service": {
      "key": "SERVICE",
      "isEmployee": false,
      "timeRecording": "TIME_REPORT_OR_INVOICE",
      "paidForObservedHolidays": true,
      "invoiceDeadlineDays": 60,
      "eligibility": {
        "annualLeave": false, "sickLeave": false, "otherLeave": false, "overtime": false,
        "thirteenthMonth": false, "healthInsurance": false, "severance": false, "relocationAllowance": false
      }
    },
    "consultant": {
      "key": "CONSULTANT",
      "isEmployee": false,
      "timeRecording": "DELIVERABLES_AND_INVOICE",
      "invoiceDeadlineDays": 60,
      "paymentSlaBusinessDays": 10,
      "selectionMethods": ["LEAST_COST", "QUALIFICATIONS_BASED"],
      "finalReportRequired": true,
      "eligibility": {
        "annualLeave": false, "sickLeave": false, "otherLeave": false, "overtime": false,
        "thirteenthMonth": false, "healthInsurance": false, "severance": false, "relocationAllowance": false
      }
    },
    "intern": {
      "key": "INTERN",
      "isEmployee": false,
      "timeRecording": "DAILY_ATTENDANCE",
      "monthlyStipend": 150,
      "stipendCurrency": "USD",
      "defaultDurationMonths": 3,
      "maxTotalDurationMonths": 6,
      "requiresTor": true,
      "requiresUniversityLetter": true,
      "endEvaluationRequired": true,
      "certificateOnSatisfactoryEvaluation": true,
      "eligibility": {
        "annualLeave": false, "sickLeave": false, "otherLeave": false, "overtime": false,
        "thirteenthMonth": false, "healthInsurance": false, "severance": false, "relocationAllowance": false
      }
    }
  },

  "approvals": {
    "delegationEnabled": true,
    "escalationAfterBusinessDays": 3
  },

  "recruitment": {
    "newPositionApprovers": ["HEAD_OF_OFFICE", "FINANCE_DIRECTOR"],
    "channels": ["WEBSITE", "JOB_BOARDS", "NEWSPAPER", "NGO_NETWORKS"],
    "allowEmergencyDirectSourcing": true,
    "minimumAge": 18,
    "familyRelationRule": "noDirectReporting",
    "flagBusinessRelatedCandidates": true,
    "flagGovernmentEmployees": true,
    "panel": { "standardSize": 3, "minSize": 2, "requiredRoles": ["HR_OFFICER", "DEPARTMENT_HEAD"] },
    "allowRemoteInterviews": true,
    "reimburseCandidateTravel": false,
    "seniorPositionsRequireHeadInterview": true,
    "hiringAuthority": "HEAD_OF_OFFICE",
    "references": { "min": 2, "minFromPreviousEmployer": 1, "allowPostHireInEmergency": true },
    "internalPreference": true,
    "formerEmployeePreference": true,
    "internalApplicantMustNotifyManager": true,
    "cvBankRetentionMonths": 24
  },

