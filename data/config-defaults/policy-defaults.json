    "orientationWithinDays": 5,
    "mandatoryTrainingFrequency": "monthly",
    "requiredAcknowledgements": [
      "EMPLOYEE_HANDBOOK",
      "CODE_OF_CONDUCT",
      "SAFEGUARDING_PSEA",
      "ANTI_HARASSMENT",
      "CONFIDENTIALITY_NDA",
      "EMPLOYMENT_TERMS_STATEMENT",
      "DATA_PRIVACY_NOTICE"
    ],
    "personnelFileChecklist": [
      { "code": "ID_DOCUMENT", "required": true, "expires": true },
      { "code": "CV", "required": true, "expires": false },
      { "code": "CERTIFICATES", "required": true, "expires": false },
      { "code": "SIGNED_CONTRACT", "required": true, "expires": false },
      { "code": "SIGNED_JOB_DESCRIPTION", "required": true, "expires": false },
      { "code": "INTERVIEW_EVALUATIONS", "required": true, "expires": false },
      { "code": "REFERENCE_CHECKS", "required": true, "expires": false },
      { "code": "SCREENING_CLEARANCE", "required": true, "expires": true },
      { "code": "POLICY_ACKNOWLEDGEMENTS", "required": true, "expires": false },
      { "code": "BANK_DETAILS", "required": true, "expires": false },
      { "code": "EMERGENCY_CONTACTS", "required": true, "expires": false },
      { "code": "DEPENDANTS", "required": false, "expires": false },
      { "code": "PROFESSIONAL_LICENSE", "required": false, "expires": true }
    ]
  },

