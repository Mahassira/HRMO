  "probation": {
    "appliesTo": ["NEW", "REHIRE", "PROMOTION"],
    "durationMonths": 3,
    "maxExtensions": 1,
    "extensionMonths": 1,
    "noticeDays": 0,
    "nonSickLeaveAsUnpaid": true,
    "reminderDaysBefore": 14
  },

  "lifecycle": {
    "relocationAllowance": { "enabled": true, "excludeSelfRequested": true, "oneTime": true },
    "temporaryTransferMaxMonths": 1,
    "acting": { "maxMonths": 4, "allowancePercent": 10, "minMonthsForAllowance": 1, "reviewEveryMonths": 3, "extensionApprover": "HEAD_OF_OFFICE" },
    "contractExpiryReminderDays": [60, 30, 14],
    "relocatableStaff": {
      "requireJustificationOnRequisition": true,
      "coverRoundTripFromPointOfHire": true,
      "leaveTravelEveryMonths": 2,
      "recoverTravelOnEarlyExit": true
